# --- Core -------------------------------------------------------------------
# Postgres (docker compose up -d db gives you this URL)
DATABASE_URL="postgresql://outbranch:outbranch@localhost:5442/outbranch"

# Auth.js — generate with: npx auth secret
AUTH_SECRET=""
# Optional OAuth provider
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""
# Allow passwordless guest/demo sign-in (public demo for judges)
AUTH_ENABLE_GUEST="true"

# --- Providers ----------------------------------------------------------------
ANTHROPIC_API_KEY=""
QLOO_API_KEY=""
# Hackathon keys use the hackathon host; override if your key targets another
QLOO_API_URL="https://hackathon.api.qloo.com"

# live | fixture  — fixture mode serves clearly labeled recorded data
PROVIDER_MODE="live"

# --- Background jobs (Inngest) -------------------------------------------------
# Not required locally when running `npx inngest-cli dev`
INNGEST_EVENT_KEY=""
INNGEST_SIGNING_KEY=""
