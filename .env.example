# --- Core -------------------------------------------------------------------
# Postgres (docker compose up -d db gives you this URL)
DATABASE_URL="postgresql://outbranch:outbranch@localhost:5442/outbranch"

# Auth.js — generate with: npx auth secret
AUTH_SECRET=""
# Passwordless guest sign-in (recommended for public demos)
AUTH_ENABLE_GUEST="true"
# Optional GitHub OAuth app
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# --- Providers ----------------------------------------------------------------
# Workspace-scoped Anthropic API key
ANTHROPIC_API_KEY=""
QLOO_API_KEY=""
# Hackathon keys only work against the hackathon host
QLOO_API_URL="https://hackathon.api.qloo.com"

# live | fixture — fixture mode serves clearly labelled synthetic Qloo data
PROVIDER_MODE="live"

# --- Public demo guardrails ------------------------------------------------------
# Research jobs allowed per hour across all users (guests get fresh workspaces)
GLOBAL_JOBS_PER_HOUR="60"
# Optional: stop new research once 24h model-token spend reaches this amount (USD)
DAILY_SPEND_LIMIT_USD=""

# --- Background jobs (Inngest) -------------------------------------------------
# Leave empty locally and run `npm run inngest`. Required in production.
INNGEST_EVENT_KEY=""
INNGEST_SIGNING_KEY=""

# --- Tests ---------------------------------------------------------------------
# Integration tests default to postgresql://outbranch:outbranch@localhost:5442/outbranch_test
# TEST_DATABASE_URL=""
# E2E_BASE_URL="http://localhost:3000"
